@startuml
title SmartQuote Backend - Purchase Ordering Context

hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false

package "Shared (generic)" #F2F2F2 {
    abstract class "AggregateRoot<TId>" as AggregateRoot
    interface IDomainEvent

    class UserId <<Value Object>> {
        + Value: UUID
    }

    class Money <<Value Object>> {
        + Amount: decimal
        + Currency: string
    }
}

package "PurchaseOrdering.Interfaces" #EADCF8 {
    class OrderingPoliciesController <<ASP.NET Core Controller>> {
        + Suppliers(status, page, pageSize)
        + Enable(supplierId, resource)
        + Suspend(supplierId, resource)
        + Reactivate(supplierId, resource)
        + Put(requestId, resource)
        + Budget(requestId)
        + Check(runId, quotationId)
    }
    class PurchaseOrdersController <<ASP.NET Core Controller>> {
        + ApproveAndGenerate(runId, quotationId, request): ActionResult
        + GetById(purchaseOrderId): ActionResult
        + GetBySimulation(runId): ActionResult
    }
}

package "PurchaseOrdering.Application" #DCEEFF {
    class OrderingPolicyService <<Application Service>> {
        + DecideSupplierAsync(id, action, reason, expectedVersion)
        + PutBudgetAsync(requestId, amount, currency, reason, expectedVersion)
        + GetBudgetAsync(requestId)
        + CheckBudgetAsync(runId, quotationId)
        + Assess(snapshot, budget): BudgetAssessment
    }
    class SupplierDirectoryService <<Published Service>> {
        + RegisterIdentifiedAsync(taxIdentifier, businessName): UUID
        + GetEligibilityAsync(identifiers): IReadOnlyList
    }
    interface ISupplierDirectory <<Published Contract>>
    interface IOrderingPolicyStore <<Port>>
    interface IOrderingPolicyLease <<Transactional Port>>
    interface IOrderingRequestReader <<Port>>
    class PurchaseOrderApplicationService <<Application Service>> {
        + ApproveAndGenerate(command): PurchaseOrder
        + GetById(purchaseOrderId): PurchaseOrderView
        + GetBySimulation(runId): PurchaseOrderView
    }

    class ApprovedDecisionMapper <<Anti-Corruption Mapper>> {
        + Map(snapshot): ApprovedPurchaseDecision
    }

    interface IPurchaseOrderRepository <<Port>> {
        + GetByIdAsync(purchaseOrderId): PurchaseOrder
        + FindBySimulationAsync(simulationRunId): PurchaseOrder
        + FindByIdempotencyKeyAsync(key): PurchaseOrder
        + AddAsync(purchaseOrder): void
    }

    interface IOrderNumberGenerator <<Port>> {
        + NextAsync(): OrderNumber
    }
}

package "Contract from Evaluation & Simulation" #F2F2F2 {
    interface ISimulationDecisionReader <<Imported Contract>> {
        + GetSourceReferenceAsync(runId, quotationId): SimulationDecisionReference
        + GetApprovedSnapshot(runId, quotationId): ApprovedSimulationSnapshot
    }

    class ApprovedSimulationSnapshot <<Immutable DTO>> {
        + SimulationRunId: string
        + RequestId: string
        + SelectedQuotationId: string
        + SupplierId: string
        + SupplierName: string
        + Currency: string
        + OrderLines: IReadOnlyList
        + DeliveryTerms: string
        + InputFingerprint: string
        + IsCurrent: bool
        + ExchangeRate: ApprovedExchangeRateSnapshot?
        + ComparableTotalPen: decimal?
    }
}

package "PurchaseOrdering.Domain" #DFF2E1 {
    class SupplierAccount <<Aggregate Root>> {
        + Id: UUID
        + TaxIdentifier: string
        + BusinessName: string
        + Status: string
        + Version: long
        + CreatedAt: DateTimeOffset
        + Register(taxIdentifier, businessName, now): SupplierAccount
        + Decide(action, reason, actorId, now)
    }
    class SupplierEligibilityEntry <<Immutable History>> {
        + PreviousStatus: string
        + NewStatus: string
        + DecidedBy: UUID
        + DecidedAt: DateTimeOffset
        + Reason: string
        + Version: long
    }
    class PurchaseBudget <<Aggregate Root>> {
        + RequestId: UUID
        + AmountPen: decimal
        + Version: long
        + Create(requestId, amount, currency, reason, actorId, now): PurchaseBudget
        + Revise(amount, currency, reason, actorId, now)
    }
    class PurchaseBudgetRevision <<Immutable History>> {
        + Version: long
        + AmountPen: decimal
        + AuthorizedBy: UUID
        + AuthorizedAt: DateTimeOffset
        + Reason: string
    }
    class BudgetAssessment <<Value Object>> {
        + Status: string
        + BudgetVersion: long?
        + BudgetAmountPen: decimal?
        + TotalPen: decimal
        + MarginPen: decimal?
        + ExcessPen: decimal?
        + CanApprove: bool
        + Evaluate(version, limit, decisionAmountsPen): BudgetAssessment
    }
    class ApprovalPolicyEvidence <<Immutable Value Object>> {
        + SupplierAccountId: UUID
        + SupplierEligibilityVersion: long
        + BudgetVersion: long?
        + BudgetAmountPen: decimal?
        + TotalPen: decimal
        + MarginPen: decimal?
        + ExchangeRate: decimal?
        + ExchangeRateSource: string?
        + RateType: string?
        + RatePublishedOn: DateOnly?
        + RateRetrievedAt: DateTimeOffset?
    }
    class PurchaseOrder <<Aggregate Root>> {
        - Id: PurchaseOrderId
        - OrderNumber: OrderNumber
        - SourceDecision: SourceSimulationReference
        - Supplier: SupplierSnapshot
        - Approval: Approval
        - Status: PurchaseOrderStatus
        - Currency: string
        - DeliveryTerms: DeliveryTerms
        - CreatedAt: DateTimeOffset
        + PolicyEvidence: ApprovalPolicyEvidence?
        + Create(number, decision, approval): PurchaseOrder
        + AddLine(line): void
        + Issue(): void
        + CalculateTotal(): Money
        + RecordPolicyEvidence(evidence): void
    }

    class PurchaseOrderLine <<Entity>> {
        - Id: PurchaseOrderLineId
        - Description: string
        - Quantity: decimal
        - UnitOfMeasure: string
        - UnitPrice: decimal
        + SourceQuotationId: string?
        + OriginalCurrency: string?
        + OriginalUnitPrice: decimal?
        + CalculateSubtotal(): Money
    }

    class ApprovedPurchaseDecision <<Value Object>> {
        + SimulationRunId: string
        + PurchaseRequestId: string
        + QuotationId: string?
        + Supplier: SupplierSnapshot
        + Currency: string
        + Lines: IReadOnlyList
        + DeliveryTerms: DeliveryTerms
        + InputFingerprint: string
    }

    class ApprovedPurchaseLine <<Value Object>> {
        + Description: string
        + Quantity: decimal
        + UnitOfMeasure: string
        + UnitPrice: Money
    }

    class SupplierSnapshot <<Value Object>> {
        + SupplierId: string
        + BusinessName: string
        + TaxIdentifier: string
    }

    class Approval <<Value Object>> {
        + ApprovedBy: UserId
        + ApprovedAt: DateTimeOffset
        + IdempotencyKey: string
    }

    class SourceSimulationReference <<Value Object>> {
        + SimulationRunId: string
        + PurchaseRequestId: string
        + QuotationId: string?
        + InputFingerprint: string
    }

    class DeliveryTerms <<Value Object>> {
        + LeadTimeDays: int
        + Conditions: string
        + Destination: string
    }

    class OrderNumber <<Value Object>> {
        + Value: string
    }

    enum PurchaseOrderStatus {
        Issued
        Cancelled
    }

    class PurchaseOrderGenerator <<Domain Service>> {
        + Generate(decision, approval, orderNumber): PurchaseOrder
    }

    class PurchaseOrderIssued <<Domain Event>> {
        + PurchaseOrderId: PurchaseOrderId
        + SimulationRunId: string
        + PurchaseRequestId: string
        + OccurredAt: DateTimeOffset
    }
}

package "PurchaseOrdering.Infrastructure" #FFE4CC {
    class PostgreSqlPurchaseOrderRepository <<EF Core Adapter>> {
        + GetByIdAsync(purchaseOrderId): PurchaseOrder
        + FindBySimulationAsync(simulationRunId): PurchaseOrder
        + FindByIdempotencyKeyAsync(key): PurchaseOrder
        + AddAsync(purchaseOrder): void
    }

    class SequentialOrderNumberGenerator <<Infrastructure Service>> {
        + NextAsync(): OrderNumber
    }
}

PurchaseOrder --|> AggregateRoot
PurchaseOrderIssued ..|> IDomainEvent

PurchaseOrder *-- "1..*" PurchaseOrderLine
PurchaseOrder --> SupplierSnapshot
PurchaseOrder --> Approval
PurchaseOrder --> SourceSimulationReference
PurchaseOrder --> DeliveryTerms
PurchaseOrder --> OrderNumber
PurchaseOrder --> PurchaseOrderStatus

PurchaseOrderLine --> Money

ApprovedPurchaseDecision *-- "1..*" ApprovedPurchaseLine
ApprovedPurchaseDecision --> SupplierSnapshot
ApprovedPurchaseDecision --> DeliveryTerms
ApprovedPurchaseLine --> Money

PurchaseOrderGenerator --> ApprovedPurchaseDecision
PurchaseOrderGenerator --> Approval
PurchaseOrderGenerator --> PurchaseOrder : creates
PurchaseOrder ..> PurchaseOrderIssued : raises

PurchaseOrdersController --> PurchaseOrderApplicationService

PurchaseOrderApplicationService --> IPurchaseOrderRepository
PurchaseOrderApplicationService --> ISimulationDecisionReader
PurchaseOrderApplicationService --> ApprovedDecisionMapper
PurchaseOrderApplicationService --> PurchaseOrderGenerator
PurchaseOrderApplicationService --> IOrderNumberGenerator

ApprovedDecisionMapper --> ApprovedSimulationSnapshot
ApprovedDecisionMapper --> ApprovedPurchaseDecision : creates

PostgreSqlPurchaseOrderRepository ..|> IPurchaseOrderRepository
SequentialOrderNumberGenerator ..|> IOrderNumberGenerator

note right of PurchaseOrderApplicationService
  Flujo de generación:
  1. Comprueba la autorización del usuario.
  2. Busca una orden previa por clave idempotente.
  3. Obtiene una decisión vigente.
  4. Mapea el contrato al modelo local.
  5. Genera y persiste la orden.
  6. Ante una repetición devuelve la existente.
end note

note right of PurchaseOrder
  Invariantes:
  - Debe contener al menos una línea.
  - Todas las líneas usan la misma moneda.
  - Conserva la solicitud, cotización y
    simulación que originaron la decisión.
  - Una orden pertenece a una adjudicación.
  - En distribución, QuotationId de cabecera es null;
    se conserva la cotización de origen por línea.
end note

note bottom of PostgreSqlPurchaseOrderRepository
  La base de datos debe tener restricciones
  únicas para número e IdempotencyKey.
  La adjudicación es única por solicitud/simulación;
  la orden es única por adjudicación/proveedor.

  La comprobación de aplicación y la restricción
  de persistencia protegen contra concurrencia.
end note

OrderingPoliciesController --> OrderingPolicyService
OrderingPolicyService --> IOrderingPolicyStore
OrderingPolicyService --> IOrderingRequestReader
OrderingPolicyService --> ISimulationDecisionReader
OrderingPolicyService ..> BudgetAssessment
SupplierDirectoryService ..|> ISupplierDirectory
SupplierDirectoryService --> IOrderingPolicyStore
PurchaseOrderApplicationService --> IOrderingPolicyStore
IOrderingPolicyStore ..> IOrderingPolicyLease
SupplierAccount *-- "0..*" SupplierEligibilityEntry
PurchaseBudget *-- "1..*" PurchaseBudgetRevision
PurchaseOrder *-- "0..1" ApprovalPolicyEvidence

note bottom of BudgetAssessment
  Contrasta la suma de toda la adquisición.
  La ausencia de presupuesto no equivale a cero.
  USD conserva la tasa oficial de la simulación;
  no se consulta otra tasa al aprobar.
end note

package "PurchaseOrdering.Domain" {
    class PurchaseAward <<Aggregate>> {
        + Id: UUID
        + RequestId: UUID
        + SimulationRunId: UUID
        + Mode: string
        + InputFingerprint: string
        + IdempotencyKey: string
        + RequestHash: string
        + ApprovedBy: UUID
        + ApprovedAt: DateTimeOffset
        + TotalPen: decimal
        + BudgetVersion: long?
        + BudgetAmountPen: decimal?
        + BudgetMarginPen: decimal?
        + ExchangeRate: decimal?
        + ExchangeRateSource: string?
        + RatePublishedOn: DateOnly?
        + RateRetrievedAt: DateTimeOffset?
        + Allocations: IReadOnlyList
    }
    class AwardAllocation <<Immutable Value>> {
        + RequestedItemId: UUID
        + SupplierId: UUID
        + QuotationId: UUID
        + QuotationLineId: UUID
        + Quantity: decimal
        + OriginalCurrency: string
        + OriginalUnitPrice: decimal
        + UnitPricePen: decimal
        + AmountPen: decimal
    }
}
package "PurchaseOrdering.Application" {
    class PurchaseAwardApplicationService {
        + ApproveAsync(runId, key, command): PurchaseAwardExecution
        + GetAsync(id): PurchaseAwardView
        + GetForRequestAsync(requestId): PurchaseAwardView
        + CheckBudgetAsync(runId)
    }
    interface IPurchaseAwardStore <<Port>>
    interface IDistributedDecisionReader <<Imported Published DTO Contract>>
    interface IAtomicAwardCommitter <<Transactional Port>> {
        + PrepareAsync(requestId, reference, events, validateLockedDecision)
        + AfterCommitAsync()
    }
}
package "API Integration Infrastructure" {
    class AtomicAwardCommitter <<Cross-Context EF Transaction>>
    class OrderingOutboxDispatcher <<Durable Background Delivery>>
}
PurchaseAward *-- AwardAllocation
PurchaseAward "1" -- "1..*" PurchaseOrder : AwardId
PurchaseAwardApplicationService --> IPurchaseAwardStore
PurchaseAwardApplicationService --> IOrderingPolicyStore
PurchaseAwardApplicationService --> IAtomicAwardCommitter
PurchaseAwardApplicationService --> IDistributedDecisionReader
PurchaseOrderApplicationService --> IAtomicAwardCommitter
AtomicAwardCommitter ..|> IAtomicAwardCommitter
AtomicAwardCommitter --> OrderingOutboxDispatcher : after commit
note bottom of PurchaseAward
  US21: exactly one award per purchase request.
  One distributed PEN order per winning supplier;
  complete coverage, current authorization and global budget.
  Same key/body returns the exact order set; different body conflicts.
  Orders, award, request transition and outbox share one transaction.
  No partial issuance, even if a later insert/transition fails.
end note

@enduml
