@startuml
title SmartQuote Backend - Supply Requests Context

hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false

package "Shared (generic)" #F2F2F2 {
    abstract class "AggregateRoot<TId>" as AggregateRoot
    interface IDomainEvent

    class UserId <<Value Object>> {
        + Value: UUID
    }
}

package "SupplyRequests.Interfaces" #EADCF8 {
    class RequestCollaborationController <<ASP.NET Core Controller>>
    class RecurringRequestsController <<ASP.NET Core Controller>>
    class PurchaseRequestsController <<ASP.NET Core Controller>> {
        + Register(request): ActionResult
        + GetById(requestId): ActionResult
        + GetHistory(requestId): ActionResult
        + ChangeStatus(requestId, request): ActionResult
    }
}

package "SupplyRequests.Application" #DCEEFF {
    class RequestCollaborationService <<Application Service>> {
        + AssignAsync(requestId, analystId, reason, version)
        + RegisterAsync(requestId, itemId, requirementId, specialistId, question, version)
        + RespondAsync(id, answer, version)
        + ReviseAsync(id, replacement, reason, clarificationVersion, requestVersion)
    }
    class RecurringRequestsService <<Application Service>> {
        + CreateAsync(startDate, intervalDays, offsetDays, timeZoneId, template)
        + EditDraftAsync(id, command, version)
        + SubmitAsync(id, version)
        + PauseAsync(id, version)
    }
    class RecurringOccurrenceProcessor <<System Use Case>> {
        + ProcessAsync(scheduleId, maxOccurrences): int
    }
    interface ISupplyWorkflowStore <<Port>>
    interface IScheduleLease <<Transactional Port>>
    interface IRequestUserDirectory <<Port>> {
        + IsActiveInRoleAsync(userId, role): bool
    }
    class PurchaseRequestCommandService <<Application Service>> {
        + Register(command): PurchaseRequestId
        + AddAttachment(command): void
        + ChangeStatus(command): void
    }

    class PurchaseRequestQueryService <<Application Service>> {
        + GetById(requestId): PurchaseRequestView
        + GetHistory(requestId): RequestHistoryView
        + GetSnapshot(requestId): PurchaseRequestSnapshot
    }

    interface IPurchaseRequestRepository <<Port>> {
        + GetByIdAsync(requestId): PurchaseRequest
        + AddAsync(request): void
        + UpdateAsync(request): void
    }

    interface IRequestNotificationPort <<Port>> {
        + NotifyStatusChanged(event): void
    }

    interface IPurchaseRequestSnapshotProvider <<Published Contract>> {
        + GetSnapshot(requestId): PurchaseRequestSnapshot
    }

    class PurchaseRequestSnapshot <<Immutable DTO>> {
        + RequestId: string
        + Version: long
        + TechnicalRevision: long
        + Status: string
        + RequesterId: string
        + RequiredDate: DateOnly
        + Priority: string
        + Items: IReadOnlyList
    }

    class RequestStatusChangedNotificationHandler <<Event Handler>> {
        + Handle(event): void
    }
}

package "SupplyRequests.Domain" #DFF2E1 {
    class PurchaseRequest <<Aggregate Root>> {
        - Id: PurchaseRequestId
        - RequesterId: UserId
        - RequiredDate: DateOnly
        - Priority: RequestPriority
        - Status: RequestStatus
        - Version: long
        - TechnicalRevision: long
        - AssignedAnalystId: UUID?
        - ScheduleOccurrenceId: UUID?
        - CreatedAt: DateTimeOffset
        + Create(requesterId, requiredDate, priority): PurchaseRequest
        + AddItem(item): void
        + AddAttachment(attachment): void
        + ChangeStatus(nextStatus, changedBy, reason): void
        + AssignAnalyst(analystId, actorId, reason, now): void
        + ReviseRequirement(clarificationId, itemId, requirementId, replacement, actorId, reason, now): void
        + CreateDraft(requesterId, requiredDate, priority, items, occurrenceId, now): PurchaseRequest
        + UpdateDraft(requiredDate, priority, items, now): void
        + Submit(localToday, now): void
    }

    class TechnicalClarification <<Aggregate Root>> {
        + Id: UUID
        + RequestId: PurchaseRequestId
        + ItemId: UUID
        + RequirementId: UUID
        + AuthorId: UUID
        + SpecialistId: UUID
        + Question: string
        + Answer: string?
        + AnsweredBy: UUID?
        + AnsweredAt: DateTimeOffset?
        + Status: string
        + CreatedAt: DateTimeOffset
        + NoticeReadAt: DateTimeOffset?
        + SourceTechnicalRevision: long
        + Version: long
        + Respond(answer, actorId, now)
        + MarkRead(now)
        + MarkRevisionApplied()
    }
    class RequestAssignmentEntry <<Immutable History>> {
        + PreviousAnalystId: UUID?
        + AnalystId: UUID
        + AssignedBy: UUID
        + AssignedAt: DateTimeOffset
        + Reason: string?
    }
    class RequirementRevision <<Immutable History>> {
        + ClarificationId: UUID
        + RequirementId: UUID
        + TechnicalRevision: long
        + Previous: RequirementDefinition
        + Current: RequirementDefinition
        + ChangedBy: UUID
        + ChangedAt: DateTimeOffset
        + Reason: string
    }
    class RequirementDefinition <<Value Object>>
    class RecurringRequestSchedule <<Aggregate Root>> {
        + Id: UUID
        + OwnerId: UUID
        + StartDate: DateOnly
        + IntervalDays: int
        + RequiredDateOffsetDays: int
        + TimeZoneId: string
        + Priority: RequestPriority
        + IsActive: bool
        + NextOccurrenceDate: DateOnly
        + NextOccurrenceAt: DateTimeOffset
        + CreatedAt: DateTimeOffset
        + PausedAt: DateTimeOffset?
        + Version: long
        + RecordOccurrence(occurrenceId, requestId, now)
        + Pause(now)
    }
    class ScheduleItem <<Value Object>>
    class ScheduleRequirement <<Value Object>>
    class ScheduleOccurrence <<Immutable History>> {
        + Id: UUID
        + ScheduledDate: DateOnly
        + RequestId: UUID?
        + Status: string
        + ProcessedAt: DateTimeOffset
    }

    class RequestedItem <<Entity>> {
        - Id: RequestedItemId
        - Description: string
        - Quantity: decimal
        - UnitOfMeasure: string
        + AddRequirement(requirement): void
    }

    class TechnicalRequirement <<Entity>> {
        - Id: TechnicalRequirementId
        + Name: string
        + Operator: ComparisonOperator
        + ExpectedValue: string
        + UnitOfMeasure: string
        + IsMandatory: bool
    }

    class RequestAttachment <<Entity>> {
        - Id: RequestAttachmentId
        - FileName: string
        - ContentType: string
        - StorageKey: string
        - UploadedBy: UserId
        - UploadedAt: DateTimeOffset
    }

    class RequestStatusEntry <<Entity>> {
        - FromStatus: RequestStatus
        - ToStatus: RequestStatus
        - ChangedBy: UserId
        - ChangedAt: DateTimeOffset
        - Reason: string
    }

    enum RequestPriority {
        Normal
        High
        Emergency
    }

    enum RequestStatus {
        Draft
        Submitted
        UnderReview
        QuotationCollection
        Evaluation
        Approved
        Ordered
        Rejected
        Cancelled
    }

    enum ComparisonOperator {
        Equals
        GreaterThanOrEqual
        LessThanOrEqual
        Contains
    }

    class PurchaseRequestSubmitted <<Domain Event>> {
        + RequestId: PurchaseRequestId
        + OccurredAt: DateTimeOffset
    }

    class PurchaseRequestStatusChanged <<Domain Event>> {
        + RequestId: PurchaseRequestId
        + RequesterId: UserId
        + PreviousStatus: RequestStatus
        + NewStatus: RequestStatus
        + Reason: string
        + OccurredAt: DateTimeOffset
    }
}

package "SupplyRequests.Infrastructure" #FFE4CC {
    class SupplyWorkflowStore <<EF Core Adapter>>
    class RecurringRequestsWorker <<Hosted Service>>
    class PostgreSqlPurchaseRequestRepository <<EF Core Adapter>> {
        + GetByIdAsync(requestId): PurchaseRequest
        + AddAsync(request): void
        + UpdateAsync(request): void
    }

    class InAppRequestNotificationAdapter <<Notification Adapter>> {
        + NotifyStatusChanged(event): void
    }
}

PurchaseRequest --|> AggregateRoot
PurchaseRequestSubmitted ..|> IDomainEvent
PurchaseRequestStatusChanged ..|> IDomainEvent

PurchaseRequest *-- "1..*" RequestedItem
RequestedItem *-- "1..*" TechnicalRequirement
PurchaseRequest *-- "0..*" RequestAttachment
PurchaseRequest *-- "0..*" RequestStatusEntry
PurchaseRequest *-- "0..*" RequestAssignmentEntry
PurchaseRequest *-- "0..*" RequirementRevision
RequirementRevision *-- "2" RequirementDefinition
TechnicalClarification --> PurchaseRequest : references
RecurringRequestSchedule *-- "1..*" ScheduleItem
ScheduleItem *-- "1..*" ScheduleRequirement
RecurringRequestSchedule *-- "0..*" ScheduleOccurrence
ScheduleOccurrence --> PurchaseRequest : generated draft
RequestCollaborationController --> RequestCollaborationService
RecurringRequestsController --> RecurringRequestsService
RequestCollaborationService --> ISupplyWorkflowStore
RequestCollaborationService --> IRequestUserDirectory
RequestCollaborationService --> IPurchaseRequestRepository
RecurringRequestsService --> ISupplyWorkflowStore
RecurringRequestsService --> IRequestUserDirectory
RecurringOccurrenceProcessor --> ISupplyWorkflowStore
RecurringOccurrenceProcessor --> IPurchaseRequestRepository
SupplyWorkflowStore ..|> ISupplyWorkflowStore
ISupplyWorkflowStore ..> IScheduleLease
RecurringRequestsWorker --> RecurringOccurrenceProcessor
PurchaseRequest --> RequestPriority
PurchaseRequest --> RequestStatus
TechnicalRequirement --> ComparisonOperator

PurchaseRequest ..> PurchaseRequestSubmitted : raises
PurchaseRequest ..> PurchaseRequestStatusChanged : raises

PurchaseRequestsController --> PurchaseRequestCommandService
PurchaseRequestsController --> PurchaseRequestQueryService

PurchaseRequestCommandService --> IPurchaseRequestRepository
PurchaseRequestQueryService --> IPurchaseRequestRepository
PurchaseRequestQueryService ..|> IPurchaseRequestSnapshotProvider

RequestStatusChangedNotificationHandler --> PurchaseRequestStatusChanged
RequestStatusChangedNotificationHandler --> IRequestNotificationPort

PostgreSqlPurchaseRequestRepository ..|> IPurchaseRequestRepository
InAppRequestNotificationAdapter ..|> IRequestNotificationPort

note right of PurchaseRequest
  Invariantes:
  - Debe contener al menos un ítem.
  - Cada ítem debe tener requisitos obligatorios.
  - La fecha requerida no puede ser anterior
    a la fecha de registro.
  - Los cambios de estado conservan historial.
  - Cada modificación incrementa Version.
end note

note bottom of PurchaseRequestSnapshot
  Contrato público de solo lectura.
  Los demás contextos reciben esta copia;
  no acceden al agregado PurchaseRequest.
end note

@enduml
