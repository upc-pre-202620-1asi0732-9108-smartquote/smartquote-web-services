# Copie este archivo como .env solo en su computadora para usar Docker Compose.
# No coloque aquí una clave real ni registre .env en Git.

POSTGRES_PORT=5432
POSTGRES_DB=smartquote
POSTGRES_USER=smartquote
POSTGRES_PASSWORD=replace-with-a-local-db-password

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-pgadmin-password

Jwt__Issuer=SmartQuote
Jwt__Audience=SmartQuote.Clients
Jwt__SigningKey=replace-with-at-least-32-random-characters
IdentityAccess__Bootstrap__Password=replace-with-a-local-bootstrap-password-of-at-least-12-characters

# Stub no necesita OpenAI. Cambie a OpenAI solo cuando configure una clave real.
AI__Provider=Stub
OpenAI__ApiKey=replace-with-your-openai-key
OpenAI__Model=gpt-4.1-mini
