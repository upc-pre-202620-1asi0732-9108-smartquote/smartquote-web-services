    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>96222fc8-076f-46c0-9b2d-521ee1f910fb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
